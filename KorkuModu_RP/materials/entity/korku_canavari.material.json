{
  "materials": {
    "version": "1.0",
    "entity_alphatest": {
      "+defines": ["USE_COLOR_MASK"],
      "+states": ["Blending", "AlphaTest"],
      "vertexShader": "shaders/entity.vsh",
      "fragmentShader": "shaders/entity.fsh",
      "vertexFields": {
        "position": "Position",
        "normal": "Normal",
        "uv0": "UV0"
      },
      "samplers": {
        "diffuse": "TEXTURE_0"
      },
      "msaaSupport": "MSAA"
    },
    "entity_emissive_alpha": {
      "+states": ["Blending", "AlphaTest", "DisableCulling"],
      "vertexShader": "shaders/entity_emissive_alpha.vsh",
      "fragmentShader": "shaders/entity_emissive_alpha.fsh",
      "vertexFields": {
        "position": "Position",
        "normal": "Normal",
        "uv0": "UV0"
      },
      "samplers": {
        "diffuse": "TEXTURE_0"
      },
      "msaaSupport": "MSAA"
    }
  }
}
